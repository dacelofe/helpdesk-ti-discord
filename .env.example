# Ambiente da aplicação dentro do contêiner.
NODE_ENV=production
PORT=3000
DB_PATH=/data/helpdesk.db

# Porta local do host; mantenha-a vinculada somente a 127.0.0.1 pelo Compose.
APP_PORT=3000

# Credenciais obtidas no Discord Developer Portal. Substitua os placeholders.
DISCORD_TOKEN=SEU_TOKEN_DO_BOT
DISCORD_CHANNEL_ID=SEU_ID_DO_CANAL
DISCORD_APPLICATION_ID=SEU_ID_DA_APLICACAO
DISCORD_PUBLIC_KEY=SUA_CHAVE_PUBLICA_HEXADECIMAL_DE_64_CARACTERES

# Obrigatoriamente true em produção.
DISCORD_VALIDATE_SIGNATURE=true
